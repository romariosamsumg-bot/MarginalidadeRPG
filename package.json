{
  "name": "marginalidade-rpg",
  "private": true,
  "version": "0.1.0",
  "description": "Marginalidade RPG — O Preço do Poder. RPG urbano brasileiro fictício para navegador (v0.1).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run test && npm run build",
    "package": "node scripts/package.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "jsdom": "31.0.1",
    "typescript": "6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
